{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://method-run.github.io/idk-themetron/schema/inputs.schema.json",
  "title": "idk-themetron inputs",
  "description": "A tree of themes. Made by `npm run spec` from src/manifest.js. Draft: the inputs can change in any version before 1.0. See spec/inputs.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "description": "The version of the inputs format. Version 1 had \"neutral\" for base, and \"color\" for action only. Without a version, the inputs are version 2.",
      "enum": [
        1,
        2
      ]
    },
    "themes": {
      "description": "Theme names map to themes. The root theme is \"default\". Every other theme needs a parent.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/theme"
      }
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "role": {
      "anyOf": [
        {
          "$ref": "#/$defs/hex"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "$ref": "#/$defs/hex"
            }
          }
        }
      ]
    },
    "font": {
      "anyOf": [
        {
          "type": "string",
          "description": "A Google font family. The fallback comes from the role."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "family": {
              "type": [
                "string",
                "null"
              ],
              "description": "A Google font family, or null for the browser's font. With src, the name that the CSS gives to the files."
            },
            "fallback": {
              "type": "string",
              "description": "A CSS generic family, such as sans-serif."
            },
            "src": {
              "type": "array",
              "minItems": 1,
              "description": "Your own font files, in place of Google Fonts. Each file is one @font-face rule. Needs a family.",
              "items": {
                "$ref": "#/$defs/fontFile"
              }
            }
          }
        }
      ]
    },
    "fontFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^[^\\s\"'\\\\?#]+\\.(woff2|woff|ttf|otf)([?#][^\\s\"'\\\\]*)?$",
          "description": "The URL of a .woff2, .woff, .ttf, or .otf file. The extension sets the format."
        },
        "weight": {
          "description": "The weight of the file, such as 400, or a range for a variable font, such as \"100 900\".",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            {
              "type": "string",
              "pattern": "^(1000|[1-9]\\d{0,2})( (1000|[1-9]\\d{0,2}))?$"
            }
          ]
        },
        "style": {
          "enum": [
            "normal",
            "italic"
          ],
          "description": "The style of the file. Not set: normal."
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent": {
          "type": "string",
          "description": "The name of the parent theme. Not allowed on \"default\"."
        },
        "label": {
          "type": "string",
          "pattern": "\\S",
          "description": "The text that people see, such as \"Big Sale\". Any case, with spaces. The theme name is still the ID in classes and tokens. Not inherited."
        },
        "base": {
          "$ref": "#/$defs/role",
          "description": "The base color: backgrounds, text, borders, and quiet controls. From the parent, or from color, if not set."
        },
        "action": {
          "description": "The action color: links, buttons, checks, focus rings, and other parts that you act on. From the parent, or from color, if not set. Or a gradient, for solid fills, soft buttons, and badges.",
          "anyOf": [
            {
              "$ref": "#/$defs/role"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "color",
                "to"
              ],
              "properties": {
                "color": {
                  "$ref": "#/$defs/hex",
                  "description": "The start color."
                },
                "to": {
                  "$ref": "#/$defs/hex",
                  "description": "The end color."
                },
                "solid": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Where the solid color sits, from 0 (the start) to 1 (the end). Parts without the gradient use it. Default: 0."
                },
                "angle": {
                  "type": "number",
                  "description": "The CSS angle in degrees. Default: 180, top to bottom."
                }
              }
            }
          ]
        },
        "color": {
          "$ref": "#/$defs/hex",
          "description": "Sets both base and action. base and action override it."
        },
        "fillLabel": {
          "deprecated": true,
          "description": "Ignored. Every fill has light labels in light mode and dark labels in dark mode. To flip one part, put the class tm-invert on it."
        },
        "font": {
          "$ref": "#/$defs/font"
        },
        "headingFont": {
          "$ref": "#/$defs/font"
        },
        "monoFont": {
          "$ref": "#/$defs/font"
        },
        "typeVariance": {
          "description": "Type variance: how fast text grows above body size, a number from 0 to 1 or a word for one. Small and body text barely move. From the parent if not set.",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "enum": [
                "flat",
                "gentle",
                "classic",
                "bold",
                "dramatic"
              ]
            }
          ]
        },
        "icons": {
          "type": "object",
          "additionalProperties": false,
          "description": "How the icons look: Material Symbols. Each field comes from the parent if not set.",
          "properties": {
            "style": {
              "enum": [
                "sharp",
                "standard",
                "rounded"
              ],
              "description": "The icon style. Default: \"standard\"."
            },
            "fill": {
              "type": "boolean",
              "description": "true for filled icons, false for outlines. Default: false."
            },
            "weight": {
              "type": "integer",
              "minimum": 100,
              "maximum": 700,
              "description": "The line weight, like a font weight. Default: 400."
            }
          }
        },
        "preset": {
          "enum": [
            "balanced",
            "flat",
            "material",
            "brutalist",
            "neumorphic",
            "glass",
            "glossy",
            "playful",
            "dense"
          ],
          "description": "A set of feels. The theme's own feels override it."
        },
        "feel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roundness": {
              "description": "Round: a number from 0 to 1, a word for one, or \"inherit\" for the parent's value.",
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "enum": [
                    "square",
                    "slight",
                    "rounded",
                    "round",
                    "pill",
                    "inherit"
                  ]
                }
              ]
            },
            "spaciousness": {
              "description": "Space: a number from 0 to 1, a word for one, or \"inherit\" for the parent's value.",
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "enum": [
                    "compact",
                    "cozy",
                    "comfortable",
                    "relaxed",
                    "spacious",
                    "inherit"
                  ]
                }
              ]
            },
            "depth": {
              "description": "Depth: a number from 0 to 1, a word for one, or \"inherit\" for the parent's value.",
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "enum": [
                    "flat",
                    "low",
                    "raised",
                    "floating",
                    "inherit"
                  ]
                }
              ]
            },
            "softness": {
              "description": "Soft: a number from 0 to 1, a word for one, or \"inherit\" for the parent's value.",
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "enum": [
                    "hard",
                    "crisp",
                    "soft",
                    "pillowy",
                    "inherit"
                  ]
                }
              ]
            },
            "thinness": {
              "description": "Thin: a number from 0 to 1, a word for one, or \"inherit\" for the parent's value.",
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "enum": [
                    "chunky",
                    "heavy",
                    "regular",
                    "hairline",
                    "none",
                    "inherit"
                  ]
                }
              ]
            },
            "shininess": {
              "description": "Shine: a number from 0 to 1, a word for one, or \"inherit\" for the parent's value.",
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "enum": [
                    "matte",
                    "satin",
                    "plastic",
                    "glassy",
                    "inherit"
                  ]
                }
              ]
            },
            "clarity": {
              "description": "Clear: a number from 0 to 1, a word for one, or \"inherit\" for the parent's value.",
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "enum": [
                    "solid",
                    "tinted",
                    "frosted",
                    "clear",
                    "inherit"
                  ]
                }
              ]
            },
            "bounciness": {
              "deprecated": true,
              "description": "Ignored. This feel is removed for now."
            },
            "snappiness": {
              "deprecated": true,
              "description": "Ignored. This feel is removed for now."
            },
            "tone": {
              "deprecated": true,
              "description": "Ignored. This feel is removed for now."
            }
          }
        },
        "contrast": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "wcag",
                "apca"
              ]
            },
            "model": {
              "enum": [
                "oklch",
                "hsl"
              ]
            },
            "level": {
              "deprecated": true,
              "description": "Ignored. Every theme ships the standard level, and the enhanced level as its more-contrast variant."
            }
          }
        }
      }
    }
  }
}
