{
  "name": "@method-run/idk-themetron",
  "version": "0.4.0",
  "description": "Make an accessible design-token theme from a few human-friendly inputs.",
  "keywords": [
    "design-tokens",
    "theme",
    "theming",
    "css-variables",
    "color",
    "contrast",
    "accessibility",
    "wcag",
    "apca",
    "oklch",
    "dtcg",
    "tailwind",
    "shadcn"
  ],
  "license": "MIT",
  "author": "Pixelbandito",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/method-run/idk-themetron.git"
  },
  "homepage": "https://method-run.github.io/idk-themetron/",
  "bugs": {
    "url": "https://github.com/method-run/idk-themetron/issues"
  },
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./components.css": "./components/components.css",
    "./looks.css": "./components/looks.css",
    "./looks.scss": "./components/_looks.scss",
    "./looks.tailwind.css": "./components/looks.tailwind.css",
    "./spec/*": "./spec/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "bin",
    "src",
    "components/components.css",
    "components/looks.css",
    "components/_looks.scss",
    "components/looks.tailwind.css",
    "CHANGELOG.md",
    "spec",
    "!spec/versions"
  ],
  "bin": {
    "themetron": "./bin/themetron.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-site.js",
    "preview": "vite preview --outDir ../_site",
    "plans:preview": "npm run build && vite preview --outDir ../_site",
    "test": "node --test",
    "spec": "node scripts/spec.js",
    "fonts": "node scripts/font-choices.js",
    "spec:release": "node scripts/release-spec.js",
    "release:notes": "node scripts/release-notes.js",
    "version": "npm run spec:release && git add spec/versions",
    "examples": "node scripts/examples.js",
    "looks": "node scripts/looks.js",
    "looks:check": "node scripts/looks-check.js",
    "docs:check": "idk-plans check",
    "docs:fix": "idk-plans fix",
    "prepublishOnly": "npm test && npm run docs:check"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@method-run/idk-plans": "^0.4.0",
    "@mui/material": "^9.5.0",
    "bootstrap": "^5.3.3",
    "daisyui": "^5.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.5"
  }
}
